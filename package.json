{
   "name": "next-js-test",
   "version": "0.1.0",
   "private": true,
   "engines": {
      "bun": ">=1.3.0"
   },
   "scripts": {
      "build": "next build",
      "dev": "next dev",
      "start": "next start",
      "test": "echo 'tests will be added later'",
      "test:e2e": "",
      "test:front": "jest",
      "test:front:once": "jest",
      "test:unit": "",
      "——————————————————————————————————————————[ LINT ]——————————————————————————————————————————": "",
      "··········································( combined )": "",
      "lint:commit": "echo 'NOTE :: Run `check-for-leaks && lint-staged` once I figure out their output issues' && exit 0",
      "——————————————————————————————————————————[ UTILS ]——————————————————————————————————————————": "",
      "··········································( analysis )": "",
      "circ:check": "echo '=====[ Running the `CIRC:CHECK` script... ]====='; madge --circular .",
      "code:review": "echo '=====[ Running the `CODE:REVIEW` script... ]====='; coderabbit review --plain --type committed",
      "secrets:check": "echo '=====[ Running the `SECRETS:CHECK` script... ]====='; ggshield secret scan path . --recursive --yes",
      "··········································( type-checking )": "",
      "type:check": "echo '=====[ Running the `TYPE:CHECK` script... ]====='; tsc --noEmit",
      "type:check:trace": "echo '=====[ Running the `TYPE:CHECK:TRACE` script... ]====='; tsc --noEmit --traceResolution"
   },
   "scripts-info": {
      "build": "This creates the production Next.js build to be used for deployment (CI/CD, etc.)",
      "dev": "This starts the Next.js development server.",
      "start": "This starts a production (?) type server.",
      "test:front": "",
      "test:front:once": ""
   },
   "dependencies": {
      "classnames": "^2.5.1",
      "husky": "^9.1.7",
      "next": "^16.0.0",
      "npm-scripts-info": "^0.3.9",
      "postcss-preset-env": "^10.4.0",
      "react": "^19.2.0",
      "react-dom": "19.2.0",
      "tailwindcss": "^4.1.15"
   },
   "devDependencies": {
      "@tailwindcss/postcss": "^4.1.17",
      "acorn": "^8.15.0",
      "acorn-jsx": "^5.3.2",
      "eslint": "^9.38.0",
      "eslint-config-airbnb": "^19.0.4",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-import": "^2.32.0",
      "eslint-plugin-jest": "^29.0.1",
      "eslint-plugin-jsx-a11y": "^6.10.2",
      "eslint-plugin-prettier": "^5.5.4",
      "eslint-plugin-react": "^7.37.5",
      "eslint-plugin-react-hooks": "^7.0.0",
      "jest": "^30.2.0",
      "prettier": "^3.6.2",
      "stylelint": "^16.25.0",
      "stylelint-config-prettier": "^9.0.5",
      "stylelint-config-standard": "^39.0.1",
      "stylelint-prettier": "^5.0.3",
      "stylelint-webpack-plugin": "^5.0.1"
   }
}
